{
  "name": "usage-metering-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Usage Metering & Quota Service API (Fastify + PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run typecheck && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:integration": "vitest run --config tests/vitest.db.config.ts tests/integration",
    "test:concurrency": "vitest run --config tests/vitest.db.config.ts tests/concurrency",
    "test:perf": "node tests/performance/load-test.mjs",
    "perf:seed": "node tests/performance/seed-perf-dataset.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env src/Infrastructure/Database/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/Infrastructure/Database/cli.ts seed",
    "demo:cli": "node scripts/demo-client.mjs",
    "demo:populate": "node scripts/populate-demo.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "openai": "^7.34.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.31.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
