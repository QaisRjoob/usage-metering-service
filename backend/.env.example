# Copy to backend/.env for local development (npm run dev reads it). Never commit real secrets.
# Docker Compose does not use this file; see ../docker-compose.yml and ../.env.example.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/metering
DATABASE_POOL_MAX=20
# Operator credential, exchanged at POST /auth/token for an operator JWT (>= 16 characters).
ADMIN_API_TOKEN=change-me-local-admin-token
# HS256 secret for JWT access tokens (at least 32 characters): openssl rand -base64 48
JWT_SECRET=change-me-local-jwt-secret-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true behind HTTPS (the refresh cookie is then Secure).
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:8080
PORT=3000
LOG_LEVEL=info
RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
DEMO_API_KEY=umk_demo_local_only_do_not_use_in_production
ACCOUNT_CREATE_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=20
SIGNUP_RATE_LIMIT_PER_MINUTE=10
# Wrong credentials per minute per client IP before 429.
AUTH_FAILURE_LIMIT_PER_MINUTE=20
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = none; the client IP is the socket address).
TRUST_PROXY_HOPS=0
# Or the exact proxy addresses (IPs/CIDRs, comma-separated) to trust, e.g. the web container. Wins over hops.
TRUST_PROXY_ADDRESSES=

# AI advisor: mock (default, no key needed) or openai.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT_PER_WINDOW=10
AI_RATE_LIMIT_WINDOW_MS=60000
