# Copy to backend/.env for local development (npm run dev reads it). Never commit real secrets.
# Docker Compose does not use this file; see ../docker-compose.yml and ../.env.example.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/metering
DATABASE_POOL_MAX=20
# Operator token for /api/v1/admin/* (local/demo mechanism, >= 16 characters).
ADMIN_API_TOKEN=change-me-local-admin-token
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
PORT=3000
LOG_LEVEL=info
RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
DEMO_API_KEY=umk_demo_local_only_do_not_use_in_production
ACCOUNT_CREATE_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=20

# AI advisor: mock (default, no key needed) or openai.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT_PER_WINDOW=10
AI_RATE_LIMIT_WINDOW_MS=60000
