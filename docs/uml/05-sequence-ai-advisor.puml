@startuml 05-sequence-ai-advisor
title Sequence - AI Usage Advisor
skinparam shadowing false
autonumber

actor "Operator or company" as User
participant "Web app" as Web
participant "API /ai/advisor\n(requireAnyRole)" as Route
participant "AskAdvisorQuery" as Query
participant "UsageContextBuilder" as Ctx
database "PostgreSQL" as DB
participant "AIProvider\n(mock | OpenAI-compatible)" as Provider
participant "OpenAI / OpenRouter" as LLM <<external>>

User -> Web : ask a question
Web -> Route : POST /ai/advisor { question, month }\nBearer JWT
Route -> Route : rate limit per caller\n(AI_RATE_LIMIT_PER_WINDOW)
Route -> Query : execute(caller, question)
alt company (account token / API key)
  Query -> DB : account usage summary\n(that account only)
else operator
  Query -> DB : cross-account analytics\n(per-company requests, rejections)
end
Query -> Ctx : build context (aggregates only,\nnames sanitized, size capped)
Ctx --> Query : context + data points
Query -> Provider : generateUsageInsight(question, scope, context)
alt AI_PROVIDER=mock
  Provider --> Query : deterministic answer from the data
else AI_PROVIDER=openai
  Provider -> LLM : chat completion / responses\nstrict JSON schema
  LLM --> Provider : JSON { summary, highlights, recommendations }
  Provider -> Provider : validate JSON\n(cut-off / no credit / rate limit -> clear error)
  Provider --> Query : insight
end
Query --> Route : answer + scope + provider + model
Route --> Web : 200 AiAdvisorResponse
Web --> User : summary, highlights, recommendations

note right of LLM
  The model never queries the database
  and cannot change anything; it only
  explains numbers the service computed.
end note
@enduml
