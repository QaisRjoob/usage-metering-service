@startuml 04-sequence-signup
title Company sign-up
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam sequenceMessageAlign center
skinparam roundCorner 12
skinparam ArrowColor #4F46E5
skinparam ArrowThickness 1.3
skinparam SequenceLifeLineBorderColor #C7D2FE
skinparam ParticipantBackgroundColor #EEF2FF
skinparam ParticipantBorderColor #4F46E5
skinparam ParticipantFontStyle bold
skinparam ActorBackgroundColor #EEF2FF
skinparam ActorBorderColor #4F46E5
skinparam DatabaseBackgroundColor #EEF2FF
skinparam DatabaseBorderColor #4F46E5
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #F59E0B
skinparam SequenceGroupBorderColor #94A3B8
skinparam SequenceGroupHeaderFontColor #334155
skinparam SequenceDividerBackgroundColor #E0E7FF
skinparam SequenceDividerBorderColor #4F46E5
skinparam TitleFontSize 18

actor Applicant
participant "Web app" as Web
participant "API" as API
actor Operator

Applicant -> Web : fill in the sign-up form
Web -> API : POST /signup-requests
API --> Applicant : request id + claim code

alt approved
  Operator -> API : approve the request
  API -> API : create the account
  Applicant -> API : check status, collect key
  API --> Applicant : API key (shown once)
  Applicant -> Web : sign in with the key
else denied
  Operator -> API : deny (with a reason)
  Applicant -> API : check status
  API --> Applicant : rejected + reason
end
@enduml
