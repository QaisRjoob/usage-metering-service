@startuml 06-class-domain
title Domain model
hide empty methods
hide empty members
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam roundCorner 10
skinparam nodesep 60
skinparam ranksep 70
skinparam ArrowColor #4F46E5
skinparam TitleFontSize 18
skinparam class {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  HeaderBackgroundColor #E0E7FF
}
skinparam package {
  BorderColor #94A3B8
  FontColor #334155
}
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #F59E0B

package "Plans" {
  class Plan {
    id : uuid
    name : string
    description : string?
    scope : PlanScope
    isPredefined : boolean
    createdAt, updatedAt
  }
  class PlanVersion {
    id : uuid
    version : int
    monthlyAllowance : int
    maxUnitsPerRequest : int
    createdAt
  }
}

package "Accounts and users" {
  class Account {
    id : uuid
    name : string
    apiKeyHash : sha256
    apiKeyPrefix : string
    createdAt, updatedAt
  }
  class User {
    id : uuid
    externalUserId : string
    displayName : string?
    createdAt, updatedAt
  }
}

package "Usage" {
  class AccountUsageCounter {
    {field} period : month (UTC)
    consumed : int
  }
  class UserUsageCounter {
    {field} period : month (UTC)
    consumed : int
  }
  class UsageRecord {
    id : uuid
    requestId : string
    unitsRequested : int
    outcome : UsageOutcome
    rejectionRule : RuleCode?
    rejectionLevel : RuleLevel?
    violations : RuleViolation[]
    accountConsumedAfter : int
    userConsumedAfter : int
    {field} period : month (UTC)
    replayCount : int
    createdAt, lastReplayedAt?
  }
}

package "Access" {
  class SignupRequest {
    id : uuid
    companyName : string
    contactName : string
    contactEmail : string
    useCase : string?
    claimCodeHash : sha256
    status : SignupStatus
    decisionNote : string?
    submittedAt, decidedAt?, claimedAt?
  }
  class RefreshToken {
    id : uuid
    familyId : uuid
    tokenHash : sha256
    role : operator | account
    createdAt, expiresAt
    usedAt?, revokedAt?
  }
}

package "Quota rules (pure functions)" {
  class QuotaPolicy <<module>> {
    + evaluateRequest(units, levels : {account, user : LevelState}) : UsageDecision
    + computeQuotaNumbers(monthlyAllowance, consumed) : QuotaNumbers
  }
  class LevelState <<value>> {
    planName : string
    limits : QuotaLimits
    consumed : int
  }
  class QuotaLimits <<value>> {
    monthlyAllowance : int
    maxUnitsPerRequest : int
  }
  class UsageDecision <<value>> {
    accepted : boolean
    rejection : RuleViolation?
    violations : RuleViolation[]
  }
  class RuleViolation <<value>> {
    rule : RuleCode
    level : RuleLevel
    limit, requested : int
    remaining : int?
    message : string
  }
  class QuotaNumbers <<value>> {
    remaining : int
    utilizationPercent : number
    status : QuotaStatus
  }
}

' ---- layout hints
SignupRequest -[hidden]right- RefreshToken
AccountUsageCounter -[hidden]right- UserUsageCounter

' ---- Plans
Plan "1" *-down- "1..*" PlanVersion : versions (immutable)
Plan "1" --> "1" PlanVersion : current

' ---- Accounts and users
Account "1" *-down- "0..*" User : registers
Account "0..*" -left-> "1" Plan : account plan\n(scope = account)
User "0..*" --> "1" Plan : user plan\n(scope = user)
Account "0..1" o-- "0..*" Plan : owns custom plans

' ---- Usage
Account "1" *-- "0..*" AccountUsageCounter : one per month
User "1" *-- "0..*" UserUsageCounter : one per month
Account "1" -- "0..*" UsageRecord
User "1" -- "0..*" UsageRecord
UsageRecord "0..*" --> "1" PlanVersion : account plan version\nand user plan version

' ---- Access
SignupRequest "0..*" --> "1" Plan : requested plan\n(scope = account)
SignupRequest "0..1" -down-> "0..1" Account : creates when approved
RefreshToken "0..*" -down-> "0..1" Account : session of\n(none for the operator)

' ---- Quota rules
QuotaPolicy ..> LevelState : reads
QuotaPolicy ..> UsageDecision : returns
QuotaPolicy ..> QuotaNumbers : returns
LevelState *-- QuotaLimits
UsageDecision *-- RuleViolation

note bottom of UsageRecord
  requestId is unique per account:
  the stored decision is also
  the idempotency record.
end note

legend right
  <b>Enumerations</b>
  PlanScope, RuleLevel : account | user
  RuleCode : MAX_UNITS_PER_REQUEST | MONTHLY_ALLOWANCE
  UsageOutcome : accepted | rejected
  SignupStatus : pending | approved | rejected
  QuotaStatus : ok | warning | exhausted | over_allowance
endlegend
@enduml
