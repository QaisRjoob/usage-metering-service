# Optional overrides for `docker compose up --build`: copy to .env next to docker-compose.yml.
# Everything works without this file (mock AI, local demo admin token).

ADMIN_API_TOKEN=local-admin-token-change-me
LOG_LEVEL=info
# AI advisor: mock (default) or openai.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
