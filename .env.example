# Optional overrides for `docker compose up --build`: copy to .env next to docker-compose.yml.
# Everything works without this file (mock AI, local demo admin token).

ADMIN_API_TOKEN=local-admin-token-change-me
# Signs JWT access tokens (HS256), at least 32 characters. Use: openssl rand -base64 48
JWT_SECRET=local-jwt-secret-change-me-0123456789abcdef
# true when served over HTTPS (refresh cookie marked Secure).
COOKIE_SECURE=false
LOG_LEVEL=info
# AI advisor: mock (default) or openai.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: an OpenAI-compatible API, e.g. OpenRouter (https://openrouter.ai/api/v1) with a
# model such as openai/gpt-4o-mini or a free one ending in :free. Empty = OpenAI itself.
OPENAI_BASE_URL=
