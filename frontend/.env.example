# mock = in-browser mock services (no backend needed). api = real HTTP API.
VITE_DATA_SOURCE=mock
# Base URL of the API, including the /api/v1 prefix. Used only when VITE_DATA_SOURCE=api.
# Default /api/v1: same origin as the page (nginx and the Vite dev server forward /api to the API).
VITE_API_BASE_URL=/api/v1
# Optional: seeded demo account API key, pre-filled in the Client Demo. Local demo use only.
VITE_DEMO_API_KEY=umk_demo_local_only_do_not_use_in_production
# Optional: operator token shown as a test account on the login page. Public demos only.
VITE_DEMO_OPERATOR_TOKEN=
# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
